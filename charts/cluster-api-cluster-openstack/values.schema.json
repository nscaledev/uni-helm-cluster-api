{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"$defs": {
		"nonNegativeNumber": {
			"type": "number",
			"minimum": 0
		},
		"base64String": {
			"type": "string",
			"contentEncoding": "base64"
		},
		"stringMap": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"ipv4": {
			"type": "string",
			"format": "ipv4"
		},
		"nonEmptyIPV4List": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/ipv4"
			}
		},
		"ipv4Prefix": {
			"type": "string",
			"pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\/(?:3[0-2]|[1-2]?[0-9])$"
		},
		"nonEmptyIPV4PrefixList": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/ipv4Prefix"
			}
		},
		"ipv6Prefix": {
			"type": "string",
			"pattern": "^(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))\\/(?:12[0-8]|1[01][0-9]|[0-9]{1,2})$"
		},
		"ipPrefix": {
			"anyOf": [
				{
					"$ref": "#/$defs/ipv4Prefix"
				},
				{
					"$ref": "#/$defs/ipv6Prefix"
				}
			]
		},
		"nonEmptyIPPrefixList": {
			"type": "array",
			"minItems": 1,
			"maxItems": 2,
			"items": {
				"$ref": "#/$defs/ipPrefix"
			}
		},
		"serverSAN": {
			"anyOf": [
				{
					"type": "string",
					"format": "ipv4"
				},
				{
					"type": "string",
					"format": "hostname"
				}
			]
		},
		"nonEmptyServerSANList": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/serverSAN"
			}
		},
		"semanticVersion": {
			"type": "string",
			"pattern": "v\\d+\\.\\d+\\.\\d+"
		},
		"taint": {
			"type": "object",
			"required": [
				"key",
				"effect"
			],
			"properties": {
				"key": {
					"type": "string"
				},
				"effect": {
					"type": "string"
				},
				"value": {
					"type": "string"
				}
			}
		},
		"taintList": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/taint"
			}
		},
		"disk": {
			"type": "object",
			"required": [
				"size"
			],
			"properties": {
				"size": {
					"$ref": "#/$defs/nonNegativeNumber"
				},
				"failureDomain": {
                                        "type": "string"
                                }
			}
		},
		"machine": {
			"type": "object",
			"required": [
				"imageID",
				"flavorID"
			],
			"properties": {
				"imageID": {
                                        "type": "string"
                                },
				"flavorID": {
                                        "type": "string"
                                },
                                "disk": {
                                        "$ref": "#/$defs/disk"
                                },
				"failureDomain": {
					"type": "string"
				},
				"serverGroupID": {
                                        "type": "string"
                                }
			}
		},
		"workloadMachineSet": {
			"type": "object",
			"required": [
				"replicas",
				"machine"
			],
			"properties": {
				"replicas": {
					"$ref": "#/$defs/nonNegativeNumber"
				},
				"machine": {
					"$ref": "#/$defs/machine"
				},
				"autoscaling": {
					"type": "object",
					"required": [
						"limits"
					],
					"properties": {
						"limits": {
							"type": "object",
							"required": [
								"minReplicas",
								"maxReplicas"
							],
							"properties": {
								"minReplicas": {
									"$ref": "#/$defs/nonNegativeNumber"
								},
								"maxReplicas": {
									"$ref": "#/$defs/nonNegativeNumber"
								}
							}
						},
						"scheduler": {
							"type": "object",
							"required": [
								"cpu",
								"memory"
							],
							"properties": {
								"cpu": {
									"$ref": "#/$defs/nonNegativeNumber"
								},
								"memory": {
									"type": "string"
								},
								"gpu": {
									"type": "object",
									"required": [
										"type",
										"count"
									],
									"properties": {
										"type": {
											"type": "string"
										},
										"count": {
											"$ref": "#/$defs/nonNegativeNumber"
										}
									}
								}
							}
						}
					}
				},
				"labels": {
					"$ref": "#/$defs/stringMap"
				},
				"files": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"path",
							"content"
						],
						"properties": {
							"path": {
								"type": "string"
							},
							"content": {
								"$ref": "#/$defs/base64String"
							}
						}
					}
				}
			}
		},
		"percentage": {
			"type": "number",
			"minimum": 0,
			"maximum": 100
		}
	},
	"type": "object",
	"required": [
		"version",
		"labelDomain",
		"openstack",
		"controlPlane",
		"network"
	],
	"properties": {
		"version": {
			"$ref": "#/$defs/semanticVersion"
		},
		"labelDomain": {
			"type": "string"
		},
		"openstack": {
			"type:": "object",
			"required": [
				"cloud",
				"cloudsYAML",
				"computeFailureDomain"
			],
			"properties": {
				"cloud": {
                                        "type": "string"
				},
                                "cloudsYAML": {
					"$ref": "#/$defs/base64String"
                                },
                                "externalNetworkID": {
                                        "type": "string"
                                },
                                "ca": {
					"$ref": "#/$defs/base64String"
                                },
                                "sshKeyName": {
                                        "type": "string"
                                },
                                "computeFailureDomain": {
                                        "type": "string"
                                },
				"volumeFailureDomain": {
					"type": "string"
				}
			}
		},
		"cluster": {
			"type": "object",
			"properties": {
				"taints": {
					"$ref": "#/$defs/taintList"
				},
				"serverMetadata": {
					"$ref": "#/$defs/stringMap"
				}
			}
		},
		"api": {
			"type": "object",
			"properties": {
				"allowList": {
					"$ref": "#/$defs/nonEmptyIPV4PrefixList"
				},
				"certificateSANs": {
					"type": "array",
					"minItems": 1,
					"items": {
						"anyOf": [
							{
								"type": "string",
								"format": "ipv4"
							},
							{
								"type": "string",
								"format": "hostname"
							}
						]
					}
				}
			}
		},
                "controlPlane": {
			"type": "object",
			"required": [
				"replicas",
				"machine"
			],
			"properties": {
				"replicas": {
					"$ref": "#/$defs/nonNegativeNumber"
				},
				"machine": {
					"$ref": "#/$defs/machine"
				},
				"kubeadmSkipPhases": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"apiServer": {
					"type": "object",
					"properties": {
						"cpuLimitPercent": {
							"$ref": "#/$defs/percentage",
							"description": "Percentage of available CPU to allocate as limit for the API server"
						},
						"memoryLimitPercent": {
							"$ref": "#/$defs/percentage",
							"description": "Percentage of available memory to allocate as limit for the API server"
						}
					}
				}
			}
		},
                "workloadPools": {
			"type:": "object",
			"additionalProperties": {
				"$ref": "#/$defs/workloadMachineSet"
			}
		},
                "network": {
			"type:": "object",
			"required": [
				"nodeCIDR",
				"serviceCIDRs",
				"podCIDRs",
				"dnsNameservers"
			],
			"properties": {
				"nodeCIDR": {
					"$ref": "#/$defs/ipv4Prefix"
				},
                                "serviceCIDRs": {
					"$ref": "#/$defs/nonEmptyIPPrefixList"
                                },
                                "podCIDRs": {
					"$ref": "#/$defs/nonEmptyIPPrefixList"
                                },
                                "dnsNameservers": {
					"$ref": "#/$defs/nonEmptyIPV4List"
                                },
				"provider": {
					"type": "object",
					"required": [
						"networkID",
						"subnetID"
					],
					"properties": {
						"networkID": {
							"type": "string"
						},
						"subnetID": {
							"type": "string"
						},
						"ipv6SubnetID": {
							"type": "string"
						}
					}
				},
				"securityGroupRules": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"name",
							"direction"
						],
						"properties": {
							"name": {
								"type": "string"
							},
							"direction": {
								"type": "string",
								"enum": [
									"ingress",
									"egress"
								]
							},
							"etherType": {
								"type": "string",
								"enum": [
									"IPv4",
									"IPv6"
								]
							},
							"protocol": {
								"type": "string",
								"enum": [
									"TCP"
								]
							},
							"portRangeMin": {
								"type": "integer"
							},
							"portRangeMax": {
								"type": "integer"
							}
						}
					}
				}
			}
		}
	}
}
